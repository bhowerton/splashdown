<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licenses</title>
<style>
  body { font: 14px/1.5 -apple-system, "Segoe UI", sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; }
  pre { white-space: pre-wrap; background: #f5f5f7; padding: 1rem; border-radius: 8px; font-size: 12px; }
  li { margin: 0.1rem 0; }
  @media (prefers-color-scheme: dark) { body { background: #1c1c1e; color: #eee; } pre { background: #2c2c2e; } a { color: #8ab4ff; } }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Splashdown is built with the open-source projects below. Their licenses follow.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
