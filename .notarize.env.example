# Copy to .notarize.env (gitignored) to notarize release builds with an App
# Store Connect API key (Users and Access → Integrations → Team Keys; the
# "Developer" role is enough). scripts/package-mac.sh reads it.
APPLE_API_KEY=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
